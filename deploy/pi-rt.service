# Bare-metal deployment (no Docker). Copy to /etc/systemd/system/pi-rt.service.
#
#   sudo useradd -r -m -d /opt/pi-runtime piagent
#   sudo chown -R piagent:piagent /opt/pi-runtime
#   sudo install -m 600 deploy/env.example /etc/pi-rt.env   # then edit it
#   sudo systemctl daemon-reload && sudo systemctl enable --now pi-rt
[Unit]
Description=pi-runtime personal agent
Documentation=https://github.com/zeetree11/Tree-Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=piagent
Group=piagent
WorkingDirectory=/opt/pi-runtime
EnvironmentFile=/etc/pi-rt.env
Environment=NODE_ENV=production
Environment=PI_RT_DATA_DIR=/opt/pi-runtime/data

ExecStart=/usr/bin/node src/cli.ts serve --channel feishu

# The process handles SIGINT to close the Feishu connection and the maintenance timer.
KillSignal=SIGINT
TimeoutStopSec=30
Restart=always
RestartSec=5
# A crash loop should not hammer the API.
StartLimitIntervalSec=300
StartLimitBurst=5

# Hardening: the agent only needs its data directory and the workspace.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/pi-runtime/data /opt/pi-runtime/workspace

[Install]
WantedBy=multi-user.target
